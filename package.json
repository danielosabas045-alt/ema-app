{
  "name": "ema-database",
  "version": "2.0.0",
  "private": true,
  "description": "Espacio de trabajo EMA con PostgreSQL, usuarios e invitaciones por correo",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check app.js && node --check invite.js && node --check test/integration.test.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:browser": "playwright test test/browser.spec.js --workers=1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "supertest": "^7.3.2"
  }
}
