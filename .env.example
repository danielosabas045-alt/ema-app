# Copiar a .env solo en desarrollo. En producción usar variables privadas del alojamiento.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://ema:CAMBIAR_PASSWORD_DB@localhost:5432/ema_database
# Para Docker Compose: contraseña privada de PostgreSQL (independiente de la del admin).
POSTGRES_PASSWORD=
# Conexiones externas: require verifica el certificado TLS; disable solo red privada/local.
DATABASE_SSL=disable
ADMIN_EMAIL=danielosabas045@gmail.com
ADMIN_NAME=Daniel Osabas
# Obligatoria para crear el primer administrador. Mínimo 12 caracteres. No se sobrescribe al reiniciar.
ADMIN_PASSWORD=
# Elegir Resend HTTPS o Gmail SMTP. Sin proveedor no se simula envío.
# Resend: remitente de un dominio verificado; destinatarios Gmail admitidos por la cuenta.
RESEND_API_KEY=
MAIL_FROM=
# Gmail: contraseña DE APLICACIÓN de Google, nunca la contraseña normal.
# Render Free bloquea SMTP. Allí usar Resend HTTPS.
GMAIL_USER=danielosabas045@gmail.com
GMAIL_APP_PASSWORD=
